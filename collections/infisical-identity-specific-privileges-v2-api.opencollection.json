          "docs": "Delete the specified identity privilege."
        },
        {
          "info": {
            "name": "getIdentityProjectAdditionalPrivilegeBySlug",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.infisical.com/api/v2/identity-project-additional-privilege/slug/:privilegeSlug",
            "params": [
              {
                "name": "identityId",
                "value": "",
                "type": "query",
                "description": "The ID of the machine identity to list."
              },
              {
                "name": "projectSlug",
                "value": "",
                "type": "query",
                "description": "The slug of the project of the identity in."
