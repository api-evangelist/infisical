            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the identity privilege."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a specific identity privilege."
        },
        {
          "info": {
