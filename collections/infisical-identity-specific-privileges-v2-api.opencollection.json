            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://us.infisical.com/api/v2/identity-project-additional-privilege/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the identity privilege."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
