              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add an additional privilege for identity."
        },
        {
          "info": {
            "name": "getIdentityProjectAdditionalPrivilege",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.infisical.com/api/v2/identity-project-additional-privilege/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the identity privilege."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve details of a specific privilege by id."
        },
