          "name": "list Organization Audit Logs",
          "request": {
            "name": "list Organization Audit Logs",
            "description": {
              "content": "Get all audit logs for an organization",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "organization",
                "audit-logs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "projectId",
                  "value": "<string>",
                  "description": "Optionally filter logs by project ID. If not provided, logs from the entire organization will be returned."
                },
                {
                  "disabled": false,
                  "key": "environment",
                  "value": "<string>",
                  "description": "The environment to filter logs by. If not provided, logs from all environments will be returned. Note that the projectId parameter must also be provided."
                },
                {
                  "disabled": false,
                  "key": "actorType",
                  "value": "<string>",
                  "description": "The type of actor to filter audit logs by. Must be provided when the actor parameter targets a non-user actor type (e.g. identity, kmipClient)."
                },
                {
                  "disabled": false,
                  "key": "secretPath",
                  "value": "<string>",
                  "description": "The path of the secret to query audit logs for. Note that the projectId parameter must also be provided."
                },
                {
                  "disabled": false,
                  "key": "secretKey",
                  "value": "<string>",
                  "description": "The key of the secret to query audit logs for. Note that the projectId parameter must also be provided."
                },
                {
                  "disabled": false,
                  "key": "userAgentType",
                  "value": "<string>",
                  "description": "Choose which consuming application to export audit logs for."
                },
                {
                  "disabled": false,
                  "key": "eventMetadata",
                  "value": "<string>",
                  "description": "Filter by event metadata key-value pairs. Formatted as `key1=value1,key2=value2`, with comma-separation."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "The date to start the export from."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "The date to end the export at."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "The offset to start from. If you enter 10, it will start from the 10th audit log."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "The number of audit logs to return."
                },
                {
                  "disabled": false,
                  "key": "actor",
                  "value": "<string>",
                  "description": "The ID of a specific actor to filter audit logs by. For user actors this is the userId; for identity actors this is the identityId. When filtering non-user actor types, the actorType parameter must also be provided."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
