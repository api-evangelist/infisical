                "description": "The slug of the environment to list folders from."
              },
              {
                "name": "lastSecretModified",
                "value": "",
                "type": "query",
                "description": "The timestamp used to filter folders with secrets modified after the specified date. The format for this timestamp is ISO 8601 (e.g. 2025-04-01T09:41:45-04:00)"
              },
              {
                "name": "path",
                "value": "",
                "type": "query",
                "description": "The path to list folders from."
              },
              {
                "name": "directory",
                "value": "",
